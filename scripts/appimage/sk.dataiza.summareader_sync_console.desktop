[Desktop Entry]
Type=Application
Name=SummaReader Sync Server
GenericName=Sync server
Comment=Keeps a SummaReader library in step across your own devices
Exec=summareader_sync_console
Icon=sk.dataiza.summareader_sync_console
Terminal=false
Categories=Utility;Network;
Keywords=summareader;sync;server;reader;
# The GTK application id, which linux/CMakeLists.txt sets and
# runner/my_application.cc hands to g_set_prgname. Without it a running window
# is not matched to this entry, so the launcher shows the app twice — once as
# the icon you clicked and once as an unnamed window.
StartupWMClass=sk.dataiza.summareader_sync_console
